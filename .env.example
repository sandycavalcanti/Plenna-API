# ==================================================
# BANCO DE DADOS
# ==================================================

# URL principal de conexão com o PostgreSQL.
DATABASE_URL="DATABASE_URL"

# Conexão direta utilizada quando necessária pelo Prisma.
DIRECT_URL="DIRECT_URL"


# ==================================================
# AUTENTICAÇÃO
# ==================================================

# Chave utilizada para assinatura e validação dos tokens JWT da aplicação.
JWT_SECRET="JWT_SECRET"


# ==================================================
# API
# ==================================================

# URL pública base da API.
API_BASE_URL="https://plenna-api-orpin.vercel.app"


# ==================================================
# GOOGLE / GMAIL
# ==================================================

# Credenciais OAuth da aplicação cadastrada no Google Cloud.
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# Endpoint para o qual o Google redireciona após o consentimento OAuth.
GOOGLE_REDIRECT_URI="https://your-domain.com/email/callback"


# ==================================================
# SINCRONIZAÇÃO DE E-MAILS
# ==================================================

# Habilita ou desabilita a sincronização automática de e-mails.
EMAIL_SYNC_ENABLED="true"

# Quantidade de dias consultados na primeira sincronização da conta.
EMAIL_SYNC_LOOKBACK_DAYS="30"

# Quantidade máxima de mensagens buscadas por lote no Gmail.
EMAIL_SYNC_BATCH_SIZE="25"

# Quantidade máxima de mensagens realmente processadas por execução.
EMAIL_SYNC_MAX_MESSAGES_PER_RUN="25"

# Quantidade máxima de usuários processados por execução automática.
EMAIL_SYNC_MAX_USERS_PER_RUN="10"

# Segredo utilizado para autenticar chamadas realizadas pelo scheduler.
CRON_SECRET="CRON_SECRET"


# ==================================================
# INTELIGÊNCIA ARTIFICIAL — GEMINI
# ==================================================

# Chave da API Gemini utilizada somente como fallback da classificação.
GEMINI_API_KEY="GEMINI_API_KEY"

# Modelo Gemini utilizado pela aplicação.
GEMINI_MODEL="gemini-3.6-flash"

# Tempo máximo, em milissegundos, de espera por resposta do Gemini.
GEMINI_TIMEOUT_MS="8000"

# Tempo de espera, em milissegundos, após o Gemini responder rate limit.
GEMINI_RATE_LIMIT_COOLDOWN_MS="60000"


# ==================================================
# INTELIGÊNCIA ARTIFICIAL — REQUESTY
# ==================================================

# Chave usada pelo provider ativo de IA do fluxo de e-mail.
REQUESTY_API_KEY="REQUESTY_API_KEY"

# Modelo configurável para classificação e extração de e-mails.
REQUESTY_EMAIL_MODEL="nvidia/nemotron-3-nano-30b-a3b"

# Tempo máximo, em milissegundos, de espera por resposta do Requesty.
REQUESTY_TIMEOUT_MS="8000"
