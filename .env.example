# ==================================================
# BANCO DE DADOS
# ==================================================

# URL principal de conexão com o PostgreSQL.
DATABASE_URL="DATABASE_URL"

# Conexão direta utilizada quando necessária pelo Prisma.
DIRECT_URL="DIRECT_URL"


# ==================================================
# AUTENTICAÇÃO
# ==================================================

# Chave utilizada para assinatura e validação dos tokens JWT da aplicação.
JWT_SECRET="JWT_SECRET"


# ==================================================
# API
# ==================================================

# URL pública base da API.
API_BASE_URL="https://plenna-api-orpin.vercel.app"


# ==================================================
# GOOGLE / GMAIL
# ==================================================

# Credenciais OAuth da aplicação cadastrada no Google Cloud.
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# Endpoint para o qual o Google redireciona após o consentimento OAuth.
GOOGLE_REDIRECT_URI="https://your-domain.com/email/callback"


# ==================================================
# SINCRONIZAÇÃO DE E-MAILS
# ==================================================

# Habilita ou desabilita a sincronização automática de e-mails.
EMAIL_SYNC_ENABLED="true"

# Quantidade máxima de mensagens analisadas na primeira sincronização.
EMAIL_SYNC_INITIAL_MESSAGES="30"

# Quantidade máxima de mensagens buscadas por lote no Gmail.
EMAIL_SYNC_BATCH_SIZE="25"

# Quantidade máxima de mensagens realmente processadas por execução.
EMAIL_SYNC_MAX_MESSAGES_PER_RUN="25"

# Quantidade máxima de usuários processados por execução automática.
EMAIL_SYNC_MAX_USERS_PER_RUN="10"

# Janela conservadora, em horas, para reconciliacao sem numero de pedido.
EMAIL_PURCHASE_RECONCILIATION_WINDOW_HOURS="48"

# Tamanho maximo, em bytes, para attachments XML/PDF mantidos somente em memoria.
EMAIL_ATTACHMENT_MAX_BYTES="10485760"

# Habilita o enriquecimento opcional por links fiscais externos.
EMAIL_FISCAL_LINK_FETCH_ENABLED="false"

# Limites defensivos para cada download e execucao de links fiscais.
EMAIL_FISCAL_LINK_MAX_BYTES="5242880"
EMAIL_FISCAL_LINK_TIMEOUT_MS="8000"
EMAIL_FISCAL_LINK_MAX_REDIRECTS="3"
EMAIL_FISCAL_LINK_MAX_PER_EMAIL="3"


# ==================================================
# EXPO PUSH / NOTIFICAÇÕES
# ==================================================

# Mantém a entrega externa desligada por padrão até o ambiente estar configurado.
EXPO_PUSH_ENABLED="false"

# Opcional: access token do Expo Push Service.
EXPO_PUSH_ACCESS_TOKEN=""

# Timeout de cada requisição ao Expo Push Service, em milissegundos.
EXPO_PUSH_TIMEOUT_MS="5000"

# Tamanho máximo de cada lote enviado ao Expo Push Service (máximo efetivo: 100).
EXPO_PUSH_BATCH_SIZE="100"

# Número máximo de novas tentativas após uma falha transitória.
EXPO_PUSH_MAX_RETRIES="2"

# Atraso base do backoff exponencial, em milissegundos.
EXPO_PUSH_RETRY_BASE_DELAY_MS="250"

# Quantidade de usuários ativos lidos por lote no cron sazonal.
SEASONAL_NOTIFICATION_USER_BATCH_SIZE="100"

# Limites do processamento de compras recorrentes.
RECURRENCE_PROCESSING_BATCH_SIZE="25"
RECURRENCE_PROCESSING_MAX_OCCURRENCES_PER_RUN="25"
RECURRENCE_PROCESSING_TRANSACTION_TIMEOUT_MS="10000"

# O cron de compras recorrentes nasce desabilitado e exige habilitaÃ§Ã£o manual.
RECURRENCE_CRON_ENABLED="false"

# Segredo utilizado para autenticar chamadas realizadas pelo scheduler.
CRON_SECRET="CRON_SECRET"


# ==================================================
# INTELIGÊNCIA ARTIFICIAL — REQUESTY
# ==================================================

# Chave usada pelo provider ativo de IA do fluxo de e-mail.
# Provider ativo: requesty (default) ou codex_local (somente desenvolvimento local).
AI_PROVIDER="requesty"

# Timeout do Codex local, em milissegundos.
CODEX_LOCAL_TIMEOUT_MS="30000"

REQUESTY_API_KEY="REQUESTY_API_KEY"

# Modelo configurável para classificação e extração de e-mails.
REQUESTY_EMAIL_MODEL="nvidia/nemotron-3-nano-30b-a3b"

# Modelo para respostas conversacionais de texto livre.
# Se omitido, usa REQUESTY_EMAIL_MODEL.
REQUESTY_CHAT_MODEL="nvidia/nemotron-3-nano-30b-a3b"

# Tempo de espera, em milissegundos, após o Requesty responder rate limit.
REQUESTY_RATE_LIMIT_COOLDOWN_MS="60000"

# Tempo máximo, em milissegundos, de espera por resposta do Requesty.
REQUESTY_TIMEOUT_MS="8000"


# ==================================================
# CHAT CONVERSACIONAL
# ==================================================

# Limite de texto aceito por mensagem do chat (maximo do contrato: 4000).
CHAT_MAX_MESSAGE_CHARS="4000"

# Quantidade maxima de mensagens da conversa enviadas ao provider.
CHAT_CONTEXT_MAX_MESSAGES="30"

# Orcamento maximo de caracteres do system prompt + contexto conversacional.
CHAT_CONTEXT_MAX_CHARS="12000"

# Limites defensivos do tool calling no chat.
AI_TOOL_MAX_CALLS="8"
AI_TOOL_MAX_ROUNDS="4"
AI_TOOL_TIMEOUT_MS="20000"
AI_TOOL_EXECUTION_TIMEOUT_MS="5000"
AI_TOOL_RESULT_MAX_CHARS="12000"

# Recomendações persistidas: a redação externa permanece desligada até aprovação de privacidade.
AI_RECOMMENDATIONS_AI_ENABLED="false"
AI_RECOMMENDATIONS_MAX_CANDIDATES="3"
AI_RECOMMENDATIONS_MAX_CONTEXT_CHARS="6000"
AI_RECOMMENDATIONS_TIMEOUT_MS="5000"

# Proatividade: execução interna controlada; cron e provider externo permanecem fora desta fase.
AI_PROACTIVITY_ENABLED="false"
AI_PROACTIVITY_AI_ENABLED="false"
# Aprovacao explicita para enviar fatos financeiros ao provider configurado.
AI_PROACTIVITY_EXTERNAL_APPROVED="false"
AI_PROACTIVITY_COOLDOWN_DAYS="7"
AI_PROACTIVITY_MAX_CANDIDATES="3"
AI_PROACTIVITY_MAX_ATTEMPTS="1"
AI_PROACTIVITY_MAX_CONTEXT_CHARS="4000"
AI_PROACTIVITY_TIMEOUT_MS="5000"
AI_PROACTIVITY_QUIET_START="21:00"
AI_PROACTIVITY_QUIET_END="08:00"
AI_PROACTIVITY_TIMEZONE="America/Sao_Paulo"

# Automacao diaria RF026/RF027: permanece desligada ate a validacao manual do SQL.
AI_AUTOMATION_ENABLED="false"
AI_AUTOMATION_BATCH_SIZE="5"
AI_AUTOMATION_MAX_USERS="25"
AI_AUTOMATION_TIMEOUT_MS="50000"
AI_AUTOMATION_MAX_ERRORS="5"
AI_AUTOMATION_MAX_RECOMMENDATION_CALLS="25"
AI_AUTOMATION_MAX_PROACTIVITY_CALLS="25"
AI_AUTOMATION_LEASE_MS="120000"
AI_AUTOMATION_TIMEZONE="America/Sao_Paulo"
